# /etc/default/zqfw - environment file for zqfw systemd service
# Uncomment and modify as needed

# Interface to attach to (default: auto-detect default route)
# ZQFW_IFACE=eth0

# Quarantine duration (default: 5m)
# ZQFW_QUARANTINE=5m

# Reap interval (default: 5s)
# ZQFW_REAP_INTERVAL=5s

# Risk threshold 0-1 (default: 0.8)
# ZQFW_THRESHOLD=0.8

# Block IP quarantine (default: false)
# ZQFW_BLOCK_IP=true

# Metrics address (default: 127.0.0.1:9790)
# ZQFW_METRICS_ADDR=127.0.0.1:9790

# Audit log path (default: /var/log/zqfw/audit.jsonl)
# ZQFW_AUDIT=/var/log/zqfw/audit.jsonl

# Pin directory for fail-closed map persistence
# ZQFW_PIN_DIR=/sys/fs/bpf/zqfw

# Enable hit events
# ZQFW_HIT_EVENTS=true